{
    "name": "mohamedhabibwork/laravel-spatial",
    "description": "Multi-database spatial data types extension for Laravel supporting MySQL 8+ and PostgreSQL 16+ (with PostGIS).",
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:unit": "phpunit -c phpunit.xml.dist --testsuite unit",
        "test:integration": "phpunit -c phpunit.xml.dist --testsuite integration"
    },
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Joseph Estefane",
            "email": "estefanejoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "illuminate/database": "^9.0||^10.0||^11.0||^12.0",
        "geo-io/wkb-parser": "^v1.0.2",
        "jmikola/geojson": "^1.1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "~10.3.1 || ~11.0 || ~12.0",
        "laravel/laravel": "^9.0||^10.0||^11.0||^12.0",
        "doctrine/dbal": "^3 || ^4",
        "laravel/browser-kit-testing": "^2.0",
        "mockery/mockery": "^1.3",
        "laravel/pint": "^1 || ^2"
    },
    "autoload": {
        "psr-4": {
            "Habib\\LaravelSpatial\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Unit",
            "tests/Integration"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Habib\\LaravelSpatial\\SpatialServiceProvider"
            ]
        }
    }
}